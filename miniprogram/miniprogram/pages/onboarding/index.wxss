.onboarding-page .progress { margin-bottom: 12px; }
.onboarding-page .form-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px 12px; margin-top: 16px; padding: 0; }
.onboarding-page .form-grid > view { min-width: 0; margin-top: 0; }
.onboarding-page .wide-field { grid-column: 1 / -1; }
.onboarding-page .field-label { font-size: 13px; margin-bottom: 6px; }
.onboarding-page .field, .onboarding-page .picker { min-height: 44px; padding: 10px 12px; font-size: 14px; line-height: 22px; }
.onboarding-page input.field {
  height: 44px;
  min-height: 44px;
  padding-top: 0;
  padding-bottom: 0;
  line-height: 44px;
}
.onboarding-page .options { margin-top: 8px; }
.onboarding-page .form-actions { display: flex; gap: 12px; margin-top: 16px; }
.onboarding-page .form-actions .primary { flex: 1; width: auto; margin: 0; }
.onboarding-page .form-actions .secondary { width: 88px; margin: 0; padding: 11px 8px; }
