/* Shared native UI system: quiet surfaces, clear controls, restrained green. */
page {
  --canvas: #f5f6f2; --surface: #fdfefa; --ink: #223c30;
  --muted: #64756b; --brand: #246b50; --soft: #e7eee3; --line: #dce4d9;
  background: var(--canvas); color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 16px; line-height: 1.65;
}
view, button, input, textarea { box-sizing: border-box; }
.page { max-width: 600px; margin: 0 auto; padding: 24px 24px 32px; padding-bottom: calc(32px + env(safe-area-inset-bottom)); }
.eyebrow { color: var(--brand); font-size: 13px; font-weight: 600; letter-spacing: 1px; }
.title { font-size: 28px; line-height: 1.4; font-weight: 600; letter-spacing: -.6px; margin: 10px 0 12px; }
.subtitle { color: var(--muted); font-size: 15px; line-height: 1.85; max-width: 30em; }
.muted, .hint { color: var(--muted); font-size: 13px; line-height: 1.7; }
.hint { margin-top: 10px; }
.section { margin-top: 28px; }
.section-title { font-weight: 600; font-size: 17px; margin-bottom: 14px; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.stack { padding-top: 6px; }
.stack > view { margin-top: 24px; }
.field-label { display: block; font-size: 14px; color: #405b4c; font-weight: 500; margin-bottom: 10px; }
.field {
  width: 100%; min-height: 54px; border: 1px solid var(--line); border-radius: 14px;
  background: var(--surface); padding: 14px 16px; color: var(--ink); font-size: 16px; line-height: 24px;
}
textarea.field { min-height: 120px; height: 120px; padding-top: 14px; line-height: 1.8; }
.picker { min-height: 54px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
button {
  min-height: 48px; font-size: 15px; line-height: 24px; border-radius: 14px;
  padding: 12px 16px; margin: 0; font-weight: 500; letter-spacing: .2px;
  transition: background-color 160ms ease-out, opacity 160ms ease-out;
}
button::after { border: none; }
.primary {
  width: 100%; min-height: 56px; margin-top: 28px; padding: 16px 20px;
  background: var(--brand); color: #f7faf3; font-weight: 600; border-radius: 18px;
  box-shadow: 0 6px 16px rgba(35, 87, 61, .10);
}
.secondary { width: 100%; margin-top: 12px; background: var(--surface); border: 1px solid var(--line); color: var(--brand); }
.link { background: transparent; color: var(--muted); padding: 12px 6px; font-size: 13px; }
.page > .link { width: 100%; margin-top: 8px; }
.pressed { opacity: .72; }
button[disabled] { opacity: 1; background: #e2e8df; color: #6c7b70; box-shadow: none; }
.options { display: flex; flex-wrap: wrap; margin: -5px; }
.option {
  width: calc(50% - 10px); min-height: 52px; margin: 5px;
  background: var(--surface); border: 1px solid var(--line); color: #4b6254; text-align: left;
  padding: 13px 14px; font-size: 14px;
}
.option.full { width: 100%; margin: 6px 0; min-height: 56px; padding: 15px 16px; }
.option.selected { border-color: var(--brand); background: #e5efe3; color: #20533d; box-shadow: inset 0 0 0 1px var(--brand); }
.error { margin-top: 16px; padding: 14px 16px; border-radius: 14px; background: #faeae4; color: #872d24; font-size: 14px; }
.notice { color: #657469; font-size: 12px; line-height: 1.8; margin-top: 28px; padding: 16px 0 0; border-top: 1px solid var(--line); }
.score { font-size: 56px; line-height: 1.15; font-weight: 500; color: var(--brand); font-variant-numeric: tabular-nums; letter-spacing: -2px; }
.score .muted { letter-spacing: 0; font-size: 16px; }
.score-panel { background: #eaf0e5; padding: 24px 20px 20px; border-radius: 24px; margin-top: 26px; }
.score-panel .score { text-align: center; }
.score-ends { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; color: #5e7264; }
slider { margin: 14px 0 4px; min-height: 44px; }
.divider { border-top: 1px solid var(--line); margin-top: 28px; padding-top: 24px; }
.success { background: var(--soft); color: #28553e; padding: 22px 20px; border-radius: 20px; margin-top: 24px; font-size: 17px; }
.danger { background: #f6e9e3; color: #872d24; margin-top: 20px; width: 100%; }
.center { text-align: center; }
.progress { display: flex; gap: 6px; margin: 0 0 24px; }
.progress-line { flex: 1; height: 4px; border-radius: 4px; background: #dfe6da; }
.progress-line.active { background: #397756; }
@media (max-width: 360px) {
  .page { padding-left: 18px; padding-right: 18px; }
  .title { font-size: 25px; }
  .option { padding-left: 10px; padding-right: 10px; }
}
@media (prefers-reduced-motion: reduce) { button { transition: none; } }

/* Compact task forms retain natural height for errors, keyboards and large text. */
.compact-page { padding: 16px 20px; padding-bottom: calc(16px + env(safe-area-inset-bottom)); }
.compact-page .title { font-size: 25px; margin: 6px 0; }
.compact-page .subtitle { font-size: 14px; line-height: 1.6; }
.compact-page .section { margin-top: 16px; }
.compact-page .section-title { font-size: 16px; margin-bottom: 8px; }
.compact-page .hint { margin-top: 6px; }
.compact-page .options { margin: -4px; }
.compact-page .option { width: calc(33.333333% - 8px); min-height: 44px; margin: 4px; padding: 9px 4px; font-size: 13px; line-height: 24px; text-align: center; }
.compact-page .option.selected { font-weight: 600; }
.compact-page .score-panel { margin-top: 16px; padding: 12px 16px; border-radius: 18px; }
.compact-page .score { font-size: 40px; }
.compact-page slider { margin: 4px 0; min-height: 44px; }
.compact-page .primary { min-height: 48px; padding: 12px 16px; margin-top: 16px; border-radius: 14px; }
.compact-page .link { min-height: 44px; padding: 10px 4px; }
.compact-page > .link { margin-top: 4px; }
.compact-page .note-toggle { width: 100%; margin-top: 8px; text-align: left; }
.compact-page textarea.field { min-height: 80px; height: 80px; padding: 10px 12px; font-size: 14px; }
.compact-page .error { padding: 10px 12px; margin-top: 12px; }
@media (max-width: 360px) { .compact-page { padding-left: 16px; padding-right: 16px; } }
@media (max-height: 600px) {
  .compact-page { padding-top: 10px; padding-bottom: calc(10px + env(safe-area-inset-bottom)); }
  .compact-page .section, .compact-page .score-panel, .compact-page .primary { margin-top: 12px; }
  .compact-page .title { font-size: 23px; }
}
